            "value": 50
        },
        "minnow_factor": {
            "type": "constant",
            "value": 0.0
        },
        "SNADV_diversion_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "SNADV_diversion_calibration",
                "irrigation_demand_SNADV_sim"
            ]
        },
        "SNADV_diversion_calibration": {
            "type": "constant",
            "value": 0.3,
            "comment": "correcting the aquacrop output to match observations"
        },
        "irrigation_demand_SNADV_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "SNADV_croprequirements_mm",
                "SNADV_area_ac",
                0.00328084
            ],
            "comment": "compute the value of KC*PET*AREA; constants to convert from mm to feet"
        },
        "SNADV_croprequirements_mm": {
            "type": "dataframe",
            "url": "../input/obs_irrigation/irrigation_requirements.csv",
            "index_col": "date",
            "parse_dates": true,
            "column": "SNADV"
        },
        "SNADV_area_ac": {
            "type": "dataframe",
            "url": "../input/obs_irrigation/irrigated_areas_historical.csv",
            "index_col": "date",
            "parse_dates": true,
            "column": "SNADV"
        },
        "SNADV_irrigation_loss_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "SNADV_diversion_sim",
                "SNADV_irr_not_crop_use",
                "SNADV_irr_loss"
            ]
        },
        "SNADV_irr_loss": {
            "type": "constant",
            "value": 0.1,
            "comment": "this factor decides how much of the water not used by the plants is lost vs. return flow"
        },
        "SNADV_irr_not_loss": {
            "type": "aggregated",
            "agg_func": "sum",
            "parameters": [1, {"type": "negative", "parameter": "SNADV_irr_loss"}],
            "comment": "the fraction that is not lost, take 1 minus the fraction that is lost"
        },
        "SNADV_irrigation_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "SNADV_diversion_sim",
                "SNADV_irr_crop_use"
            ]
        },
        "SNADV_irr_crop_use": {
            "type": "constant",
            "value": 0.7
        },
        "SNADV_irr_not_crop_use": {
            "type": "aggregated",
            "agg_func": "sum",
            "parameters": [1, {"type": "negative", "parameter": "SNADV_irr_crop_use"}],
            "comment": "the fraction that is not used by the crops, what is not used by crops is split between loss & return"
        },
        "SNADV_return_flow_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "SNADV_diversion_sim",
                "SNADV_irr_not_crop_use",
                "SNADV_irr_not_loss"
            ]
        },
        "LFCC_prediction_sim": {
            "type": "LFCCSimulation",
            "url": {
                "folder": "../input/lfcc_model"
            }
        },
        "returnflow_NWR_sim": {
            "type": "ReturnFlowNWR"
        }
    }
}