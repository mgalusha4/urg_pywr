    "parameters": {
        "cost_elephant_butte_storage": {
            "type": "controlcurveinterpolated",
            "storage_node": "elephant_butte_reservoir",
            "control_curves": [
                0.99,
                0.01
            ],
            "values": [
                300.0,
                300.0,
                -300.0,
                -600.0
            ]
        },
        "pet_over_elephant_butte_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "pet_over_elephant_butte_mm",
                "elephant_butte_area_acre",
                0.00328084,
                0.4
            ]
        },
        "pet_over_elephant_butte_mm": {
            "type": "dataframe",
            "url": "../input/reservoirs/elephant_butte/pet_mm.csv",
            "index_col": "date",
            "parse_dates": true,
            "column": "pet"
        },
        "elephant_butte_area_acre": {
            "type": "VolumeAreaCurve",
            "url": [
                "../input/reservoirs",
                "elephant_butte"
            ],
            "factor": 1
        },
        "cost_elephant_butte_pet": {
            "type": "constant",
            "url": "../input/reservoirs/reservoirs_cost.csv",
            "index_col": "Reservoir",
            "index": "elephant_butte",
            "column": "PETCost"
        },
        "precip_over_elephant_butte": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "precip_over_elephant_butte_mm",
                0.00328084,
                "elephant_butte_area_acre"
            ]
        },
        "precip_over_elephant_butte_mm": {
            "type": "dataframe",
            "url": "../input/reservoirs/elephant_butte/precip_mm.csv",
            "index_col": "date",
            "parse_dates": true,
            "column": "precip"
        },
        "cost_caballo_storage": {
            "type": "controlcurveinterpolated",
            "storage_node": "caballo_reservoir",
            "control_curves": [
                0.99,
                0.01
            ],
            "values": [
                300.0,
                300.0,
                -300.0,
                -600.0
            ]
        },
        "pet_over_caballo_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "pet_over_caballo_mm",
                "caballo_area_acre",
                0.00328084,
                0.8
            ]
        },
        "pet_over_caballo_mm": {
            "type": "dataframe",
            "url": "../input/reservoirs/caballo/pet_mm.csv",
            "index_col": "date",
            "parse_dates": true,
            "column": "pet"
        },
        "caballo_area_acre": {
            "type": "VolumeAreaCurve",
            "url": [
                "../input/reservoirs",
                "caballo"
            ],
            "factor": 1
        },
        "cost_caballo_pet": {
            "type": "constant",
            "url": "../input/reservoirs/reservoirs_cost.csv",
            "index_col": "Reservoir",
            "index": "caballo",
            "column": "PETCost"
        },
        "precip_over_caballo": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "precip_over_caballo_mm",
                0.00328084,
                "caballo_area_acre",
                1.05
            ]
        },
        "precip_over_caballo_mm": {
            "type": "dataframe",
            "url": "../input/reservoirs/caballo/precip_mm.csv",
            "index_col": "date",
            "parse_dates": true,
            "column": "precip"
        },
        "EBID_diversion_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "EBID_diversion_calibration",
                "irrigation_demand_EBID_sim"
            ]
        },
        "EBID_diversion_calibration": {
            "type": "constant",
            "value": 0.4,
            "comment": "correcting the aquacrop output to match observations"
        },
        "irrigation_demand_EBID_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "EBID_croprequirements_mm",
                "EBID_area_ac",
                0.00328084
            ],
            "comment": "compute the value of KC*PET*AREA; constants to convert from mm to feet"
        },
        "EBID_croprequirements_mm": {
            "type": "dataframe",
            "url": "../input/obs_irrigation/irrigation_requirements.csv",
            "index_col": "date",
            "parse_dates": true,
            "column": "EBID"
        },
        "EBID_area_ac": {
            "type": "dataframe",
            "url": "../input/obs_irrigation/irrigated_areas_historical.csv",
            "index_col": "date",
            "parse_dates": true,
            "column": "EBID"
        },
        "EBID_irrigation_loss_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "EBID_diversion_sim",
                "EBID_irr_not_crop_use",
                "EBID_irr_loss"
            ]
        },
        "EBID_irr_loss": {
            "type": "constant",
            "value": 0.7,
            "comment": "this factor decides how much of the water not used by the plants is lost vs. return flow"
        },
        "EBID_irr_not_loss": {
            "type": "aggregated",
            "agg_func": "sum",
            "parameters": [1, {"type": "negative", "parameter": "EBID_irr_loss"}],
            "comment": "the fraction that is not lost, take 1 minus the fraction that is lost"
        },
        "EBID_irrigation_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "EBID_diversion_sim",
                "EBID_irr_crop_use"
            ]
        },
        "EBID_irr_crop_use": {
            "type": "constant",
            "value": 0.8
        },
        "EBID_irr_not_crop_use": {
            "type": "aggregated",
            "agg_func": "sum",
            "parameters": [1, {"type": "negative", "parameter": "EBID_irr_crop_use"}],
            "comment": "the fraction that is not used by the crops, what is not used by crops is split between loss & return"
        },
        "EBID_return_flow_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "EBID_diversion_sim",
                "EBID_irr_not_crop_use",
                "EBID_irr_not_loss"
            ]
        },
        "EPID_diversion_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "EPID_diversion_calibration",
                "irrigation_demand_EPID_sim"
            ]
        },
        "EPID_diversion_calibration": {
            "type": "constant",
            "value": 0.5,
            "comment": "correcting the aquacrop output to match observations"
        },
        "irrigation_demand_EPID_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "EPID_croprequirements_mm",
                "EPID_area_ac",
                0.00328084
            ],
            "comment": "compute the value of KC*PET*AREA; constants to convert from mm to feet"
        },
        "EPID_croprequirements_mm": {
            "type": "dataframe",
            "url": "../input/obs_irrigation/irrigation_requirements.csv",
            "index_col": "date",
            "parse_dates": true,
            "column": "EPID"
        },
        "EPID_area_ac": {
            "type": "dataframe",
            "url": "../input/obs_irrigation/irrigated_areas_historical.csv",
            "index_col": "date",
            "parse_dates": true,
            "column": "EPID"
        },
        "EPID_irrigation_loss_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "EPID_diversion_sim",
                "EPID_irr_not_crop_use",
