            ]
        },
        "EPID_irr_loss": {
            "type": "constant",
            "value": 0.7,
            "comment": "this factor decides how much of the water not used by the plants is lost vs. return flow"
        },
        "EPID_irr_not_loss": {
            "type": "aggregated",
            "agg_func": "sum",
            "parameters": [1, {"type": "negative", "parameter": "EPID_irr_loss"}],
            "comment": "the fraction that is not lost, take 1 minus the fraction that is lost"
        },
        "EPID_irrigation_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "EPID_diversion_sim",
                "EPID_irr_crop_use"
            ]
        },
        "EPID_irr_crop_use": {
            "type": "constant",
            "value": 0.8
        },
        "EPID_irr_not_crop_use": {
            "type": "aggregated",
            "agg_func": "sum",
            "parameters": [1, {"type": "negative", "parameter": "EPID_irr_crop_use"}],
            "comment": "the fraction that is not used by the crops, what is not used by crops is split between loss & return"
        },
        "EPID_return_flow_sim": {
            "type": "aggregated",
            "agg_func": "product",
            "parameters": [
                "EPID_diversion_sim",
                "EPID_irr_not_crop_use",
                "EPID_irr_not_loss"
            ]
        }
    }
